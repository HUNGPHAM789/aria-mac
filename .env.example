# ─── Ollama (local AI) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:27b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather
ARIA_ALLOWED_TELEGRAM_ID=your_telegram_user_id

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/aria.db

# ─── Memory Embeddings (optional — falls back to Ollama embeddings if not set) ─
# GEMINI_API_KEY=your_gemini_api_key

# ─── Web Search (optional) ───────────────────────────────────────────────────
# TAVILY_API_KEY=your_tavily_api_key

# ─── HTTP API Secret (for Mission Control integration) ───────────────────────
# ARIA_API_SECRET=your_secret
